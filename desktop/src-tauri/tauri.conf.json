{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stella Sora ES",
  "version": "0.2.8",
  "identifier": "es.stellasora.patch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stella Sora · Parche en español",
        "width": 1120,
        "height": 700,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
